    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "const token = jsonData.data.token;",
              "",
              "if (token) {",
              "    pm.collectionVariables.set(\"AUTH\", token);",
              "    console.log(\"AUTH token set successfully\");",
              "} else {",
              "    console.error(\"Token not found in response\");",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
